{
  "name": "blualien",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace=@blualien/client\" \"node --watch server/index.js\"",
    "dev:client": "npm run dev --workspace=@blualien/client",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build --workspace=@blualien/client",
    "start": "node server/index.js",
    "lint": "npm run lint --workspace=@blualien/client && eslint server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "resend": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3"
  }
}
